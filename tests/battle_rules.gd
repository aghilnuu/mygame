extends SceneTree
const Model = preload("res://scripts/battle/battle_model.gd")
var failures := 0
var checks := 0

func expect(condition: bool, title: String) -> void:
	checks += 1
	if not condition:
		failures += 1
		push_error(title)

func _initialize() -> void:
	var m = Model.new()
	expect(m.hand.size() == 5 and m.deck.size() == 5, "Opening hand")
	m.hand.clear()
	m.deck = [1]
	m.discard = [2,3,4]
	m.add_card("sleep")
	var draw_events: Array = m.execute()
	var first: Dictionary = draw_events.front()
	expect(first.hand.size() == 3 and first.hand[0] == 1 and first.shuffle == 1 and first.deck == 1 and first.discard == 0, "Draw immediately from deck then shuffled discard, before flow")
	m.add_card("sleep")
	draw_events = m.execute()
	first = draw_events.front()
	expect(first.hand.size() == 4 and first.deck == 0 and first.shuffle == 1 and draw_events.size() > 1, "Insufficient cards: draw remaining one, continue to flow")
	m = Model.new()
	for i in range(5):
		expect(m.add_card("sleep"), "Basic cards reusable")
	expect(not m.add_card("sleep"), "Five slot limit")
	expect(m.hand.size() == 5, "Basics do not consume specials")
	m = Model.new()
	m.add_card("dash")
	expect(m.set_target(0,Vector2i(3,4),[Vector2i(3,4)]), "Movement target")
	m.add_card("slash")
	expect(m.set_target(1,Vector2i(4,4)), "Projected attack origin")
	m.set_target(0,Vector2i(3,4),[Vector2i(3,4)])
	expect(m.queue[1].valid, "Same target confirmation preserves later card")
	m.set_target(0,Vector2i(2,3),[Vector2i(2,3)])
	expect(not m.queue[1].valid, "Retarget invalidates later cards")
	expect(m.execute().is_empty(), "Cannot execute incomplete plan")
	m = Model.new()
	m.obstacles.append(Vector2i(3,3))
	m.add_card("dash")
	m.set_target(0,Vector2i(3,3),[Vector2i(2,3),Vector2i(3,3)])
	var held: int = m.hand[0]
	m.add_card("rage",held)
	m.execute()
	expect(m.player == Vector2i(2,3) and m.interrupted, "Stops before obstacle")
	expect(held in m.hand and m.discard.is_empty(), "Unused special returned on interruption")
	m = Model.new()
	m.enemies = [{"name":"test", "pos":Vector2i(3,4),"hp":40,"mode":"lock","intent":"move","target":m.player}]
	m.add_card("slash")
	m.set_target(0,Vector2i(3,4))
	m.add_card("rage",m.hand[0])
	var frames: Array = m.execute()
	expect(m.enemies[0].hp == 18, "Slash 6 plus rage 8 twice")
	expect(frames.filter(func(f): return "连招追加" in f.message).size() == 1, "Combo event")
	expect(frames.filter(func(f): return f.message == "敌方回合结束，更新下一回合意图").size() == 2, "Slash and rage each flow once")
	expect(not m.super_armor, "Armor expires after rage enemy round; bonus does not reapply it")
	var damage_frames: Array = frames.filter(func(f): return f.message.begins_with("狂怒"))
	expect(damage_frames.size() == 2 and frames.find(damage_frames[1]) == frames.find(damage_frames[0])+1, "Both rage damage steps occur before any enemy action")
	expect(frames.filter(func(f): return f.message.begins_with("进入霸体")).size() == 1, "Bonus damage grants no additional armor")
	expect(m.discard.size() == 1 and m.hand.size() == 4, "Special discard")
	m.deck.clear()
	expect(m.draw_cards(1) == 1 and m.shuffle_count == 1 and m.discard.is_empty(), "Recycle discard")
	m = Model.new()
	m.enemies = [{"name":"lock", "pos":Vector2i(3,4),"hp":24,"mode":"lock","intent":"attack","target":Vector2i(2,3)}]
	m.enemy_round()
	expect(m.hp == 30, "Locked attack misses moved player")
	m.enemies[0].mode = "track"
	m.enemies[0].intent = "attack"
	m.enemy_round()
	expect(m.hp == 27 and m.interrupted, "Tracking attack hits and interrupts")
	m.hp = 2
	m.enemy_round()
	expect(m.result == "梦境破碎" and m.hp == 0, "Defeat")
	m = Model.new()
	m.enemies = [{"name":"last", "pos":Vector2i(3,4),"hp":6,"mode":"lock","intent":"attack","target":m.player}]
	m.add_card("slash")
	m.set_target(0,Vector2i(3,4))
	m.execute()
	expect(m.result == "战斗胜利" and m.hp == 30, "Dead enemy cannot retaliate")
	m = Model.new()
	m.enemies[0].pos = Vector2i(3,4)
	m.enemies[1].pos = Vector2i(2,3)
	m.refresh_intents()
	m.add_card("sleep")
	m.add_card("rage",m.hand[0])
	m.execute()
	expect(m.hp == 24, "Every living enemy acts once despite queue interruption")
	expect(m.hand.size() == 8 and m.discard.is_empty(), "Draw before flow and return unused special")
	expect(not m.super_armor, "Unexecuted rage cannot grant armor")
	m = Model.new()
	m.enemies[0].pos = Vector2i(3,4)
	m.enemies[1].pos = Vector2i(2,3)
	m.refresh_intents()
	m.grant_super_armor()
	m.enemy_round()
	expect(m.hp == 24, "Armor still takes damage from both enemies")
	expect(not m.interrupted, "Armor protects entire enemy round")
	expect(not m.super_armor, "Armor expires after complete round")
	m.enemy_round()
	expect(m.hp == 18 and m.interrupted, "Following round can interrupt again")
	m = Model.new()
	m.enemies = [{"name":"armortest", "pos":Vector2i(3,4),"hp":100,"mode":"track","intent":"attack","target":m.player}]
	m.grant_super_armor()
	m.add_card("sleep")
	m.remove_card(0)
	expect(m.super_armor, "Planning does not remove armor state")
	m.add_card("rage",m.hand[0])
	frames = m.execute()
	expect(not m.super_armor and m.hp == 27, "Rage flow1 is protected then expires")
	expect(frames.any(func(f): return f.super_armor), "Armor is visible in state snapshots")
	m.add_card("rage",m.hand[0])
	m.add_card("rage",m.hand[0])
	frames = m.execute()
	expect(m.hp == 21 and not m.interrupted, "Rage combo does not add enemy damage from extra flow")
	expect(m.discard.size() == 3 and not m.super_armor, "Combo consumes one card and ends armor after enemy round")
	m.hp = 2
	m.grant_super_armor()
	m.enemy_round()
	expect(m.result == "梦境破碎" and not m.super_armor, "Armor does not prevent death")
	m = Model.new()
	m.grant_super_armor()
	m.add_card("dash")
	m.set_target(0,Vector2i(4,3),[Vector2i(3,4),Vector2i(3,3),Vector2i(4,3)])
	m.execute()
	expect(m.interrupted and m.player == Vector2i(3,3), "Armor cannot pass through obstacles")
	m = Model.new()
	m.add_card("dash")
	m.set_target(0, Vector2i(3,4), [Vector2i(3,4)])
	frames = m.execute()
	expect(m.enemies[0].pos == Vector2i(4,4) and frames.any(func(f): return f.message == "守望者原地待命"), "Blocked move reports waiting")
	var stats = Model.Catalog.HUNTER.duplicate()
	stats.merge({"damage":7, "reach":2, "steps":2, "hp":50}, true)
	m.configure_enemies([{"stats":stats, "pos":Vector2i(5,4)}])
	expect(m.enemies.size() == 1 and m.enemies[0].hp == 50 and m.enemies[0].intent == "attack", "Custom enemy count, health and attack reach")
	m.enemy_round()
	expect(m.hp == 23, "Configured enemy damage")
	m.player = Vector2i(0,4)
	m.refresh_intents()
	m.enemy_round()
	expect(m.enemies[0].pos == Vector2i(3,4), "Configured move distance")
	print("BATTLE_RULES: %d checks, %d failures" % [checks,failures])
	quit(0 if failures == 0 else 1)
